# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- never commit it or paste its contents anywhere.

# Neon connection string (Neon dashboard -> Connect -> Connection string)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# A random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-value

# Cloudflare R2 (S3-compatible object storage) -- used to sync dashboard/
# report content to somewhere the hosted app can actually read, since it
# won't have access to the G: drive. From the R2 API token you create:
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-your-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
R2_BUCKET_NAME=mc-econ-intelligence

# Set to "cloud" on Render so the app reads synced content from the R2-backed
# local cache instead of the local G: drive / Analyses folder. Leave unset
# (or "local") for local development.
CONTENT_SOURCE=local
